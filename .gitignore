# --- Python bytecode / cache --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribution / packaging -------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# --- Editable install metadata (created by `pip install -e .`) ----------------
*.egg-info/
aep_core.egg-info/

# --- Test / coverage runners --------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
coverage.xml
*.cover
.hypothesis/
# JUnit XML and the tee'd pytest output the gate script reads. Both are
# produced by every local run of the CI sequence; neither is source.
junit*.xml
pytest-*.txt

# --- Type checkers / linters --------------------------------------------------
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Virtual environments -----------------------------------------------------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- IDE / editor -------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Claude Code user-local settings (do NOT push) ----------------------------
.claude/settings.local.json

# --- Agent tooling session logs (activity trace, not repository content) ------
.ai/

# --- Experiment output --------------------------------------------------------
# Ground-truth ledgers and run logs are results, not source. They are published
# with a paper release, not committed on every run.
experiments/results/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.run.jsonl

# --- Logs / runtime junk ------------------------------------------------------
*.log
pip-log.txt
pip-delete-this-directory.txt

# --- OS junk ------------------------------------------------------------------
desktop.ini

# LaTeX build products. The .tex sources and the generated tables are tracked;
# the artifacts of compiling them are not.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
# The build-provenance stamp (B21 item 3). It is a build product like the four
# above, and it is deliberately NOT tracked: it describes one machine's last
# build, not the repository's state.
#
# It sits in the same directory as the artifacts whose staleness caused the
# problem, which invites cleaning it up as an instance of that problem. It is
# not one, and the distinction is the whole point: THE OLD ARTIFACTS WERE
# SILENT WHEN WRONG; THE STAMP FAILS THE GATE WHEN WRONG. Deleting it does not
# restore the old behaviour -- it makes the gate refuse until the next build,
# which is the safe direction. See B21 item 3 and B40.
paper/.build-provenance.json
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Session scratch: staging for scripts copied into the WSL measurement tree.
.scratch/

# --- The inputs scripts/check_paper_numbers.py opens --------------------------
# `experiments/results/` above stays ignored: raw run directories are the
# evaluation and are published as an archive, not committed. But the gate that
# proves the manuscript still matches its results cannot run in CI unless the
# files it *reads* are in the checkout, and a gate that only ever runs on the
# author's laptop is not a gate. So exactly those inputs are re-included here,
# by name, at their frozen content -- analysis products only, never a run
# directory, never a sqlite ledger, never a log.
#
# Git will not re-include a file whose parent directory is excluded, so each
# level is re-opened and then re-closed with a `*` before the next one. Adding
# a file to this list means committing a result: verify it against
# experiments/results/matrix/SHA256SUMS first.
!experiments/results/
experiments/results/*
!experiments/results/g2-flakey-write-loss.json
!experiments/results/g2-flakey-write-loss-rep2.json
!experiments/results/g2-flakey-write-loss-rep3.json

!experiments/results/matrix/
experiments/results/matrix/*
!experiments/results/matrix/MANIFEST.csv
!experiments/results/matrix/SHA256SUMS
!experiments/results/matrix/analysis/
experiments/results/matrix/analysis/*
!experiments/results/matrix/analysis/comparisons-vs-aep-full.csv
!experiments/results/matrix/analysis/coverage.json
!experiments/results/matrix/analysis/latency-and-throughput.csv
!experiments/results/matrix/analysis/per-cell-metrics.csv
!experiments/results/matrix/analysis/per-execution.csv
!experiments/results/matrix/analysis/redis-kill-ablation.csv

!experiments/results/fsync-always/
experiments/results/fsync-always/*
!experiments/results/fsync-always/analysis/
experiments/results/fsync-always/analysis/*
!experiments/results/fsync-always/analysis/latency-and-throughput.csv
!experiments/results/fsync-always/analysis/per-execution.csv

# --- Phase 9's replication of the redis-kill-preack cell (Phase 8.0) ----------
# Five sessions of the same cell disagree: AEP-full recorded 10, 20, 12, 4 and
# 7 applied effects out of 30 under an identical configuration
# (reports/phase-report-9c-result-2026-08-21.md). Four of those five sessions
# live in these roots, and until now they were untracked -- so the evidence for
# 9C's central finding, and for the kill-latency mechanism that explains it,
# existed on one host and nowhere else. That is a data-loss risk, not a
# bookkeeping gap, which is why these are tracked ahead of any new collection.
#
# The frozen `matrix/` tree is NOT touched by this: these are separate results
# roots and the paper's headline row still comes from the 2026-08-07 cell. They
# are kept separate deliberately -- see reports/plan-phase-8-b2.md section 4.
#
# Same rule as above: analysis products and the manifest only, never a run
# directory, never a sqlite ledger, never a log. Verify against each root's own
# SHA256SUMS before adding anything here.
!experiments/results/b2-2026-08-21/
experiments/results/b2-2026-08-21/*
!experiments/results/b2-2026-08-21/MANIFEST.csv
!experiments/results/b2-2026-08-21/SHA256SUMS
